{
  "name": "label-studio-prelabeling-dataset-versioning",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @label-studio-prelabeling-dataset-versioning/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @label-studio-prelabeling-dataset-versioning/web build",
    "typecheck": "pnpm --filter @label-studio-prelabeling-dataset-versioning/web typecheck",
    "contract:export": "services/api/.venv/bin/python services/api/scripts/export_openapi.py",
    "contract:check": "services/api/.venv/bin/python services/api/scripts/export_openapi.py --check && pnpm --filter @label-studio-prelabeling-dataset-versioning/web exec vitest run src/lib/api-contract.test.ts",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:docs": "node scripts/gen-docs.mjs",
    "gen:check": "node scripts/gen-api.mjs --check && node scripts/gen-docs.mjs --check",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "wait-ready": "node scripts/wait-ready.mjs",
    "verify": "pnpm check:agent-docs && pnpm verify:api && pnpm verify:web",
    "verify:api": "pnpm lint:api && pnpm test:api && pnpm check:structure && pnpm test:ml",
    "verify:web": "pnpm gen:check && pnpm lint && pnpm typecheck && pnpm test:web && pnpm build",
    "verify:full": "pnpm run doctor && pnpm verify && pnpm test:e2e",
    "lint": "pnpm --filter @label-studio-prelabeling-dataset-versioning/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:web": "pnpm --filter @label-studio-prelabeling-dataset-versioning/web test",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "test:ml": "cd services/ml-backend && .venv/bin/ruff check . && .venv/bin/python -m pytest -q",
    "test:live:b2": "cd services/api && .venv/bin/python -m pytest live_tests/test_b2_connectivity.py -m live",
    "test:live:loop": "cd services/api && RUN_LIVE_LOOP_TESTS=1 .venv/bin/python -m pytest live_tests/test_annotation_loop.py -m live -s",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @label-studio-prelabeling-dataset-versioning/web exec playwright test --project=chromium",
    "test:verify": "pnpm --filter @label-studio-prelabeling-dataset-versioning/web exec playwright test --project=verify"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
